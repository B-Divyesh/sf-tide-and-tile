{
  "name": "tide-and-tile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "lint": "eslint src tests playwright.config.ts vite.config.ts",
    "test": "npm run build && playwright test",
    "test:unit": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.10.2",
    "axe-core": "^4.10.3",
    "eslint": "10.9.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.69.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
